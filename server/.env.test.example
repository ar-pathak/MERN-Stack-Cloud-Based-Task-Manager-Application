NODE_ENV=test

# Required auth secrets for integration tests
JWT_SECRET=integration-jwt-secret
REFRESH_SECRET=integration-refresh-secret

# Optional: set when running DB-backed integration tests
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Keep rate-limits from blocking test traffic
RATE_LIMIT_STORE=memory
GLOBAL_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=1000

# Mongo reliability hardening for CI/local test runs
MONGO_CONNECT_MAX_RETRIES=5
MONGO_CONNECT_RETRY_DELAY_MS=1500
MONGO_SERVER_SELECTION_TIMEOUT_MS=20000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1

# Socket integration timing hardening
SOCKET_EVENT_TIMEOUT_MS=10000
SOCKET_CONNECT_TIMEOUT_MS=10000
SOCKET_DB_POLL_INTERVAL_MS=200
CALL_RING_TIMEOUT_MS=60000
