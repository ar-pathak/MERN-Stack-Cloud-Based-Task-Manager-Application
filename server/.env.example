PORT=3000
NODE_ENV=development

# Comma-separated origins allowed for CORS/cookies.
FRONTEND_URL=http://localhost:5173

MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-long-random-secret
REFRESH_SECRET=replace-with-long-random-secret

EMAIL_USER=you@example.com
EMAIL_PASS=app-password-or-smtp-password

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional cookie overrides.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
